# URL del backend FastAPI (sin barra final).
# Desarrollo (.env.development): http://localhost:8000
# Producción (.env.production):  https://api.aurexir.com
# Vacío → el front funciona en modo "solo catálogo" (pedidos por IG/WhatsApp).
VITE_API_URL=http://localhost:8000

# Stripe Checkout es alojado por Stripe. El frontend no necesita claves de Stripe;
# STRIPE_SECRET_KEY y STRIPE_WEBHOOK_SECRET viven solo en el backend.
