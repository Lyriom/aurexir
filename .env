# URL del backend FastAPI (sin barra final).
# En desarrollo apunta al back local; `vite build` usa .env.production
# (https://api.aurexir.com), que tiene prioridad sobre este archivo.
VITE_API_URL=http://localhost:8000

# Clave PUBLICABLE de Stripe (pk_test_… en dev, pk_live_… en prod). Pública; nunca la secreta sk_….
VITE_STRIPE_PUBLISHABLE_KEY=
